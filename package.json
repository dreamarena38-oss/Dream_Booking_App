{
  "name": "football-booking-app",
  "version": "1.0.1",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "server": "node server/index.js",
    "prebuild": "expo prebuild",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "prebuild:android": "expo prebuild --platform android --clean",
    "ios:pods": "cd ios && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 pod install && cd ..",
    "ios:open": "open ios/DreamArena.xcworkspace",
    "ios:device": "npx expo run:ios --device",
    "ios:release": "npx expo run:ios --configuration Release --device",
    "ios:archive": "xcodebuild -workspace ios/DreamArena.xcworkspace -scheme DreamArena -configuration Release -archivePath ios/build/DreamArena.xcarchive archive",
    "clean": "rm -rf node_modules .expo ios/build android/app/build android/build",
    "clean:metro": "watchman watch-del-all 2>/dev/null; rm -rf $TMPDIR/metro-* $TMPDIR/haste-map-* $TMPDIR/react-*",
    "build:ios": "eas build --platform ios --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "submit:ios": "eas submit --platform ios --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/anton": "^0.4.1",
    "@expo-google-fonts/bebas-neue": "^0.4.0",
    "@expo-google-fonts/montserrat": "^0.4.1",
    "@expo-google-fonts/oswald": "^0.4.1",
    "@expo-google-fonts/poppins": "^0.4.0",
    "@expo-google-fonts/roboto": "^0.4.0",
    "@expo/metro-runtime": "~5.0.4",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/stack": "^7.4.2",
    "axios": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "expo": "~53.0.27",
    "expo-av": "^15.1.7",
    "expo-font": "^13.3.2",
    "expo-image": "~2.4.1",
    "expo-image-picker": "^16.1.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "^2.2.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-elements": "^3.4.3",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-paper": "^5.11.6",
    "react-native-ratings": "^8.1.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-vector-icons": "^10.0.3",
    "react-native-web": "^0.20.0",
    "resolve-from": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react-native": "^0.72.8",
    "typescript": "~5.8.3"
  },
  "private": true
}
